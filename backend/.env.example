# ===================================================
# Impervia Backend Environment Configuration (Template)
# ===================================================

# Application Metadata
APP_NAME=Impervia
DEBUG=false

# Security & Authentication (minimum 32 characters)
SECRET_KEY=replace_with_a_secure_jwt_secret_key_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Aiven PostgreSQL Database Credentials
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_db_password
DB_SSLMODE=require

# Data Retention Defaults
DEFAULT_RETENTION_DAYS=30
