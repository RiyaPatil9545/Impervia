# ===================================================
# Impervia Backend Environment Configuration (Template)
# ===================================================

# Application Metadata
APP_NAME=Impervia
DEBUG=false

# Security & Authentication (minimum 32 characters)
SECRET_KEY=replace_with_a_secure_jwt_secret_key_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Aiven PostgreSQL Database Credentials
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_db_password
DB_SSLMODE=require

# Data Retention Defaults
DEFAULT_RETENTION_DAYS=30

# Local SLM Intelligence Layer (Zero-Cloud Privacy Configuration)
SLM_ENABLED=true
SLM_AUTO_START=true
SLM_PROVIDER=ollama
SLM_ENDPOINT=http://127.0.0.1:11434
SLM_MODEL_NAME=qwen2.5:1.5b
SLM_TIMEOUT_SECONDS=6.0
SLM_TEMPERATURE=0.0
